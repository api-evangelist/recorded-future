   "paths": {
    "/files/{path}": {
     "delete": {
      "summary": "Delete a feed file",
      "tags": [
       "File"
      ],
      "description": "Remove a file from your organization's Fusion file system by path (public Recorded Future-managed files cannot be deleted).",
      "security": [
       {
        "ApiKeyAuth": []
       },
       {
        "idp": []
       }
      ],
      "parameters": [
       {
        "$ref": "#/components/parameters/FilePath"
       }
      ],
      "responses": {
       "200": {
        "description": "Result of operation",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/OperationResult"
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "parameters": {
     "FilePath": {
      "in": "path",
      "name": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "File path. Special characters may be required to be URL encoded depending on which HTTP client is used.\n\nFor example, the path '/public/risklists/default_ip_risklist.csv' would be URL encoded as '%2Fpublic%2Frisklists%2Fdefault_ip_risklist.csv'\nwhere the '/' character is encoded as '%2F'. See an HTML URL Encoding Reference for the full encoding table.\n",
      "example": "/public/risklists/default_ip_risklist.csv"
     }
    },
    "schemas": {
     "OperationResult": {
      "type": "object",
      "properties": {
       "result": {
        "type": "string",
        "description": "Result of operation",
        "example": "ok"
       }
      }
     }
    },
    "securitySchemes": {
     "ApiKeyAuth": {
      "description": "API Credential",
      "type": "apiKey",
      "in": "header",
      "name": "X-RFToken"
     },
     "idp": {
      "description": "Click on \"Authorize\" to be redirected to the login page.",
      "type": "oauth2",
      "flows": {
       "authorizationCode": {
        "authorizationUrl": "https://id.recordedfuture.com/authorize",
        "tokenUrl": "https://id.recordedfuture.com/token",
        "refreshUrl": "https://id.recordedfuture.com/token",
        "scopes": {}
       }
      }
     }
    }
   },
   "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": false
   }
  }
